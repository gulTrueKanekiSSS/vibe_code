DATABASE_URL="postgresql://study:study@localhost:5433/study?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TELEGRAM_CLIENT_ID=""
TELEGRAM_CLIENT_SECRET=""
# Only works when NODE_ENV=development. Production always rejects this login.
DEV_AUTH="true"
# Optional Tutor; server-only. Never use NEXT_PUBLIC_ for these values.
# Keep disabled for the initial hosting pilot, even if AI keys exist.
TUTOR_PROVIDER="disabled"
# Russia: Yandex AI Studio service-account API key and folder. No OpenAI key needed.
YANDEX_API_KEY=""
YANDEX_FOLDER_ID=""
# Optional overrides; these values are also the adapter defaults.
YANDEX_TUTOR_MODEL="yandexgpt-5.1"
YANDEX_EMBEDDING_MODEL="text-search-doc/latest"
YANDEX_QUERY_EMBEDDING_MODEL="text-search-query/latest"
# Optional alternative: set TUTOR_PROVIDER=openai and fill all three below.
OPENAI_API_KEY=""
TUTOR_MODEL=""
TUTOR_EMBEDDING_MODEL=""
